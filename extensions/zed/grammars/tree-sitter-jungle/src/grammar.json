{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "jungle",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_newline"
              },
              {
                "type": "SYMBOL",
                "name": "comment"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "pair"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_newline"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "pair"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": "[^\\r\\n]*"
          }
        ]
      }
    },
    "pair": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "key"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "value"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        }
      ]
    },
    "key": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "key_segment"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "."
              },
              {
                "type": "SYMBOL",
                "name": "key_segment"
              }
            ]
          }
        }
      ]
    },
    "key_segment": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9_-]+"
    },
    "value": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "lookup"
          },
          {
            "type": "SYMBOL",
            "name": "path_separator"
          },
          {
            "type": "SYMBOL",
            "name": "value_text"
          }
        ]
      }
    },
    "lookup": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$("
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "lookup_name"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "lookup_name": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9_.-]+"
    },
    "path_separator": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[;:]"
      }
    },
    "value_text": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^$;:\\s\\r\\n][^$;:\\r\\n]*"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}